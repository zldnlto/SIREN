{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(dart format*)",
      "Bash(pytest*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(black*)",
      "Bash(mypy*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)"
    ],
    "ask": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)"
    ],
    "deny": [
      "Read(./api/.env*)",
      "Read(./android/app/google-services.json)",
      "Read(./ios/Runner/GoogleService-Info.plist)",
      "Read(./android/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./ios/**/*.mobileprovision)",
      "Read(./**/*.pt)",
      "Read(./**/*.pth)",
      "Read(./**/*.onnx)",
      "Read(./**/*.pkl)",
      "Read(./**/*.joblib)",
      "Read(./**/*.safetensors)",
      "Read(./data/**)",
      "Read(./datasets/**)",
      "Read(./raw/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./android/app/google-services.json)",
      "Edit(./ios/Runner/GoogleService-Info.plist)",
      "Edit(./android/key.properties)",
      "Edit(./**/*.jks)",
      "Edit(./**/*.keystore)",
      "Edit(./ios/**/*.mobileprovision)",
      "Edit(./**/*.pt)",
      "Edit(./**/*.pth)",
      "Edit(./**/*.onnx)",
      "Edit(./**/*.pkl)",
      "Edit(./**/*.joblib)",
      "Edit(./**/*.safetensors)",
      "Edit(./data/**)",
      "Edit(./datasets/**)",
      "Edit(./raw/**)",
      "Edit(./runs/**)",
      "Edit(./mlruns/**)",
      "Edit(./wandb/**)",
      "Edit(./weights/**)",
      "Edit(./checkpoints/**)",
      "Bash(rm -rf*)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit-risky-change.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-issue-context.sh"
          }
        ]
      }
    ]
  }
}
