{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./api/.env*)",
      "Read(./app/**/google-services.json)",
      "Read(./app/**/GoogleService-Info.plist)",
      "Read(./vision/data/**)",
      "Read(./vision/datasets/**)",
      "Read(./vision/runs/**)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(DROP TABLE*)",
      "Bash(TRUNCATE*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/audit-risky-change.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/inject-issue-context.sh"
          }
        ]
      }
    ]
  }
}
