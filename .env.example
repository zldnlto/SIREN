# ──────────────────────────────────────────────
# SIREN API — 환경변수 템플릿
# 실제 값은 .env 파일에 작성하고 절대 커밋하지 않는다.
# ──────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# FastAPI
API_PREFIX=/api/v1
APP_NAME=SIREN API
DEBUG=false
SECRET_KEY=

# AWS S3 (선택)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
